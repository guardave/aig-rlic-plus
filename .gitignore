temp/

# Data (large files — add specific datasets as needed)
*.parquet
*.h5
*.hdf5

# Deploy-required parquet artifacts (per ECON-DS2)
!results/**/signals_*.parquet
!results/**/hmm_states_*.parquet
!results/**/markov_regime_probs_*.parquet

# Exception: FOMC SEP extracted data (small, needed by viewer)
!fomc-sep/data/**/*.parquet
!fomc-sep/data/*.parquet

# Exception: Class-A daily raw data — PINNED for reproducibility (GH#13 / issue #19).
# These daily-traded pairs' tournaments depend on the raw daily data; it was gitignored
# and lost via an unscoped rsync (2026-07-15). Pin each vintage explicitly (not a wildcard,
# so a future dated refresh stays ignored until consciously re-pinned). phlxsox already tracked.
!data/hy_ig_spy_daily_20000101_20260422.parquet
!data/gold_copper_xli_daily_20260526.parquet
!data/vix_vix3m_spy_daily_20260314.parquet

# Claude Code scheduled-tasks transient lock
.claude/scheduled_tasks.lock
.claude/settings.json

# Smoke-test run logs (regenerable output of app/_smoke_tests/*.py)
app/_smoke_tests/*.log
