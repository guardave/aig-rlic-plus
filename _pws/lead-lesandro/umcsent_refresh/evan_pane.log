import pandas as pd, numpy as np
from pathlib import Path
work=pd.read_parquet('data/umcsent_xlv_monthly_19980101_20251231.parquet').dropna(subset=['umcsent'])
oos_start=pd.Timestamp('2019-04-30'); oos_end=pd.Timestamp('2025-12-31')
sig=work['umcsent_mom']
ret=work['xlv_ret']

def metrics(name, pos):
    strat=(pos.shift(1)*ret).loc[oos_start:oos_end].dropna()
    sharpe=(strat.mean()/strat.std())*np.sqrt(12) if strat.std()>0 else 0
    ann=strat.mean()*12
    cum=(1+strat).cumprod(); dd=((cum-cum.cummax())/cum.cummax()).min()
    print(name, 'n',len(strat),'sharpe',sharpe,'ann',ann,'dd',dd,'win', (strat>0).mean(), 'trades', pos.loc[oos_start:oos_end].diff().abs().fillna(0).gt(0).sum())
    print(strat.head().to_string())

metrics('literal static no lead gt 6.95316', (sig>6.95316).astype(float))
# dynamic T3 no lead
