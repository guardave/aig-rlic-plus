+            ann_return = ann_vol = sharpe = max_dd = np.nan
+        else:
+            ann_return = r.mean() * 12
+            ann_vol = r.std() * np.sqrt(12)
+            sharpe = (r.mean() / r.std()) * np.sqrt(12) if r.std() > 0 else 0
+            eq = (1 + r.fillna(0)).cumprod()
+            max_dd = (eq / eq.cummax() - 1).min()
+        rows.append({
