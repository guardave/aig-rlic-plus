+    winner = load_winner()
+    df = load_strategy_returns()
+    rows = []
+    periods = [
+        ("Dot-Com Crash", "2000-03-01", "2002-10-31", False),
+        ("GFC", "2007-12-01", "2009-06-30", False),
+        ("COVID", "2020-02-01", "2020-12-31", True),
