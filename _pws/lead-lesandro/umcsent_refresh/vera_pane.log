+            "sharpe": round(float(sharpe), 6) if pd.notna(sharpe) else np.nan,
+            "n_obs": int(len(r)),
+            "max_drawdown": round(float(max_dd), 6) if pd.notna(max_dd) else np.nan,
+        })
