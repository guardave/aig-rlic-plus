import pandas as pd, json, numpy as np
w=json.load(open('results/umcsent_xlv/winner_summary.json'))
df=pd.read_csv('results/umcsent_xlv/strategy_returns_20260420.csv', parse_dates=['date']).set_index('date')
oos=df.loc[w['oos_period_start']:w['oos_period_end']]
r=oos['strategy_return'].astype(float)
eq=(1+r).cumprod()
calc={
 'oos_sharpe': r.mean()/r.std()*np.sqrt(12),
 'oos_ann_return': (1+r).prod()**(12/len(r))-1,
 'oos_max_drawdown': (eq/eq.cummax()-1).min(),
}
for k,v in calc.items():
 print(f'{k}: computed={v:.6f} reported={w[k]:.6f} diff={v-w[k]:+.6f}')
