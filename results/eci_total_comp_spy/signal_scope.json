{
  "pair_id": "eci_total_comp_spy",
  "schema_version": "1.0.0",
  "owner": "evan",
  "last_updated_by": "evan",
  "last_updated_at": "2026-07-06T12:57:21Z",
  "indicator_axis": {
    "canonical_column": "eci_total_comp_idx",
    "display_name": "Employment Cost Index (Total Compensation)",
    "derivatives": [
      {
        "name": "eci_total_comp_idx",
        "definition": "Employment Cost Index: Total Compensation, All Civilian, SA quarterly index (Dec 2005=100)",
        "formula": "FRED ECIALLCIV",
        "role": "raw",
        "appears_in_charts": []
      },
      {
        "name": "eci_total_comp_pct_qoq",
        "definition": "quarter-on-quarter % change (short-horizon wage momentum)",
        "formula": "100*(L_t/L_{t-1}-1)",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "eci_total_comp_pct_2q",
        "definition": "2-quarter (~6M) % change",
        "formula": "100*(L_t/L_{t-2}-1)",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "eci_total_comp_pct_yoy",
        "definition": "4-quarter % change (headline wage inflation; near-I(1) persistent)",
        "formula": "100*(L_t/L_{t-4}-1)",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "eci_total_comp_ma8q_idx",
        "definition": "8-quarter (~2yr) moving average of the level",
        "formula": "rolling mean(8)",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "eci_total_comp_dev_trend_pct",
        "definition": "% deviation of the level from its 8Q MA",
        "formula": "100*(L_t/MA8Q-1)",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "eci_total_comp_zscore_20q",
        "definition": "rolling 20Q (~5yr) z-score of the LEVEL (regime-contaminated; KPSS reject)",
        "formula": "(L_t-mean20q)/sd20q",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "eci_total_comp_yoy_zscore_20q",
        "definition": "rolling 20Q z-score of YoY growth (regime-contaminated; KPSS reject)",
        "formula": "(yoy_t-mean20q)/sd20q",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "eci_total_comp_accel_pct",
        "definition": "QoQ acceleration (pp; cleanly stationary)",
        "formula": "qoq_t - qoq_{t-1}",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "eci_total_comp_yoy_accel_pct",
        "definition": "YoY acceleration (pp; cleanly stationary)",
        "formula": "yoy_t - yoy_{t-1}",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "hmm_2state_prob_stress",
        "definition": "P(high wage-inflation regime) from 2-state HMM on YoY growth (level-regime split)",
        "formula": "GaussianHMM(yoy)",
        "role": "regime_state",
        "appears_in_charts": []
      },
      {
        "name": "markov_regime_2state",
        "definition": "P(high-variance regime) from Markov-switching regression spy_ret~yoy",
        "formula": "MarkovRegression",
        "role": "regime_state",
        "appears_in_charts": []
      }
    ]
  },
  "target_axis": {
    "canonical_column": "spy",
    "display_name": "SPY (S&P 500 ETF)",
    "derivatives": [
      {
        "name": "spy",
        "definition": "SPY adjusted quarter-end close",
        "formula": "Yahoo Finance",
        "role": "raw",
        "appears_in_charts": []
      },
      {
        "name": "spy_ret",
        "definition": "SPY quarterly return (decimal)",
        "formula": "P_t/P_{t-1}-1",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "spy_fwd_1q",
        "definition": "1-quarter forward SPY return",
        "formula": "P_{t+1}/P_t-1",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "spy_fwd_2q",
        "definition": "2-quarter forward SPY return",
        "formula": "P_{t+2}/P_t-1",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "spy_fwd_4q",
        "definition": "4-quarter forward SPY return",
        "formula": "P_{t+4}/P_t-1",
        "role": "derivative",
        "appears_in_charts": []
      }
    ]
  },
  "notes": "ECON-SD: only ECI derivatives and SPY derivatives are in scope. Controls in the parquet (unrate, dgs10, fed_funds, vix) are context columns, NOT signals. FIRST QUARTERLY pair: windows named in quarters (20Q/8Q), leads in quarters, sqrt(4) annualization. SA source \u2014 no seasonal-contamination constraint. regime_story: false (CP2 skipped)."
}