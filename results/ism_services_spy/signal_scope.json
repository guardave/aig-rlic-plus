    "derivatives": [
      {
        "name": "ism_services_pmi",
        "definition": "Headline ISM Services PMI diffusion index level",
        "formula": "Data Master.xlsx / ISM PMI / CDis, CSta - ISM Services PMI",
        "role": "raw",
        "appears_in_charts": []
      },
      {
        "name": "ism_services_gap_50",
        "definition": "PMI minus the 50 expansion threshold",
        "formula": "PMI_t - 50",
        "role": "threshold_input",
        "appears_in_charts": []
      },
      {
        "name": "ism_services_delta",
        "definition": "One-month change in PMI, in index points",
        "formula": "PMI_t - PMI_{t-1}",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "ism_services_3m_change",
        "definition": "Three-month change in PMI, in index points",
        "formula": "PMI_t - PMI_{t-3}",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "ism_services_6m_change",
        "definition": "Six-month change in PMI, in index points",
        "formula": "PMI_t - PMI_{t-6}",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "ism_services_zscore_60m",
        "definition": "Rolling 60-month z-score of the PMI level",
        "formula": "(PMI_t - mean60(PMI)) / sd60(PMI)",
        "role": "threshold_input",
        "appears_in_charts": []
      },
      {
        "name": "ism_services_above_50",
        "definition": "Flag equal to 1 when PMI is above 50",
        "formula": "indicator(PMI_t > 50)",
        "role": "threshold_input",
        "appears_in_charts": []
      },
      {
        "name": "hmm_2state_prob_stress",
        "definition": "Probability of the low-PMI contraction regime from a 2-state HMM",
        "formula": "GaussianHMM(PMI)",
        "role": "regime_state",
        "appears_in_charts": []
      },
      {
        "name": "markov_regime_2state",
        "definition": "Probability of the high-volatility regime from a Markov-switching regression",
        "formula": "MarkovRegression(spy_ret ~ PMI gap)",
        "role": "regime_state",
        "appears_in_charts": []
      }
    ]
