  "indicator_axis": {
    "canonical_column": "nhs_nsa",
    "display_name": "New Home Sales (NSA)",
    "derivatives": [
      {
        "name": "nhs_nsa",
        "definition": "New Home Sales, 000s NSA (FRED HSN1FNSA). NON-STATIONARY, seasonal \u2014 not used as a signal",
        "formula": "FRED HSN1FNSA",
        "role": "raw",
        "appears_in_charts": []
      },
      {
        "name": "nhs_pct_yoy",
        "definition": "12-month % change in NHS (headline deseasonalised signal)",
        "formula": "100*(N_t/N_{t-12}-1)",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "nhs_yoy_accel_pct",
        "definition": "month-on-month change in YoY growth (acceleration, pp)",
        "formula": "yoy_t - yoy_{t-1}",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "nhs_3m_pct_yoy",
        "definition": "YoY change of 3-month moving average",
        "formula": "100*(MA3_t/MA3_{t-12}-1)",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "nhs_sa",
        "definition": "STL seasonally-adjusted NHS level. NON-STATIONARY \u2014 not a signal",
        "formula": "STL(HSN1FNSA)",
        "role": "raw",
        "appears_in_charts": []
      },
      {
        "name": "nhs_sa_pct_mom",
        "definition": "1-month % change of STL SA level",
        "formula": "100*(SA_t/SA_{t-1}-1)",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "nhs_sa_3m_pct",
        "definition": "3-month % change of STL SA level",
        "formula": "100*(SA_t/SA_{t-3}-1)",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "nhs_yoy_zscore_120m",
        "definition": "rolling 120m z-score of YoY growth",
        "formula": "(yoy_t-mean120)/sd120",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "nhs_yoy_contraction_flag",
        "definition": "1 when NHS YoY growth < 0",
        "formula": "indicator(yoy<0)",
        "role": "regime_state",
        "appears_in_charts": []
      },
      {
        "name": "hmm_2state_prob_stress",
        "definition": "P(high-variance regime) from 2-state HMM on YoY growth",
        "formula": "GaussianHMM(yoy)",
        "role": "regime_state",
        "appears_in_charts": []
      },
      {
        "name": "markov_regime_2state",
        "definition": "P(high-variance regime) from Markov-switching regression spy_ret~yoy",
        "formula": "MarkovRegression",
        "role": "regime_state",
        "appears_in_charts": []
      }
    ]
  },
  "target_axis": {
    "canonical_column": "spy",
    "display_name": "SPY (S&P 500 ETF)",
    "derivatives": [
      {
        "name": "spy",
        "definition": "SPY adjusted month-end close",
        "formula": "Yahoo Finance",
        "role": "raw",
        "appears_in_charts": []
      },
      {
        "name": "spy_ret",
        "definition": "SPY monthly return (decimal)",
        "formula": "P_t/P_{t-1}-1",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "spy_fwd_1m",
        "definition": "1-month forward SPY return",
        "formula": "P_{t+1}/P_t-1",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "spy_fwd_3m",
        "definition": "3-month forward SPY return",
        "formula": "P_{t+3}/P_t-1",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "spy_fwd_6m",
        "definition": "6-month forward SPY return",
        "formula": "P_{t+6}/P_t-1",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "spy_fwd_12m",
        "definition": "12-month forward SPY return",
        "formula": "P_{t+12}/P_t-1",
        "role": "derivative",
        "appears_in_charts": []
      }
    ]
  },
  "notes": "ECON-SD: only NHS derivatives and SPY derivatives are in scope. The NHS LEVEL (nhs_nsa) is NSA and NON-STATIONARY; the STL level (nhs_sa) is also non-stationary \u2014 both excluded from the signal set. Only stationary YoY/STL-MoM/z-score transforms are used. regime_story: false (CP2 skipped)."
