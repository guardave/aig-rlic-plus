{
  "pair_id": "permit_spy",
  "schema_version": "1.0.0",
  "owner": "evan",
  "last_updated_by": "evan",
  "last_updated_at": "2026-10-18T05:13:04.531856+00:00",
  "indicator_axis": {
    "canonical_column": "permit",
    "display_name": "Building Permits (PERMIT)",
    "derivatives": [
      {
        "name": "permit",
        "definition": "Building permits level (thousands of units, SAAR)",
        "formula": "FRED PERMIT",
        "role": "raw",
        "appears_in_charts": [
          "hero"
        ]
      },
      {
        "name": "permit_yoy",
        "definition": "Year-over-year percent change",
        "formula": "(x_t / x_{t-12} - 1) * 100",
        "role": "derivative",
        "appears_in_charts": [
          "regime_stats",
          "local_projections",
          "quantile_coef"
        ]
      },
      {
        "name": "permit_mom",
        "definition": "Month-over-month percent change",
        "formula": "(x_t / x_{t-1} - 1) * 100",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "permit_dev_trend",
        "definition": "Level minus its 12-month average",
        "formula": "x_t - mean12",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "permit_zscore_60m",
        "definition": "Level versus its five-year history",
        "formula": "(x - mean60)/std60",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "permit_mom_3m",
        "definition": "Three-month change in level",
        "formula": "x_t - x_{t-3}",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "permit_mom_6m",
        "definition": "Six-month change in level",
        "formula": "x_t - x_{t-6}",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "permit_accel",
        "definition": "Change in the monthly percent change",
        "formula": "mom_t - mom_{t-1}",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "permit_contraction",
        "definition": "Year-over-year change below zero",
        "formula": "1[yoy < 0]",
        "role": "regime_state",
        "appears_in_charts": []
      }
    ]
  },
  "target_axis": {
    "canonical_column": "spy",
    "display_name": "SPY adjusted close",
    "derivatives": [
      {
        "name": "spy",
        "definition": "SPY adjusted month-end close",
        "formula": "month-end adjusted close",
        "role": "raw",
        "appears_in_charts": [
          "hero",
          "equity_curves"
        ]
      },
      {
        "name": "spy_ret",
        "definition": "SPY monthly return",
        "formula": "spy_t / spy_{t-1} - 1",
        "role": "derivative",
        "appears_in_charts": []
      },
      {
        "name": "spy_fwd_1m",
        "definition": "One-month forward SPY return",
        "formula": "spy_{t+1} / spy_t - 1",
        "role": "derivative",
        "appears_in_charts": [
          "correlation_heatmap"
        ]
      },
      {
        "name": "spy_fwd_3m",
        "definition": "Three-month forward SPY return",
        "formula": "spy_{t+3} / spy_t - 1",
        "role": "derivative",
        "appears_in_charts": [
          "local_projections",
          "quantile_coef"
        ]
      },
      {
        "name": "spy_fwd_6m",
        "definition": "Six-month forward SPY return",
        "formula": "spy_{t+6} / spy_t - 1",
        "role": "derivative",
        "appears_in_charts": [
          "correlation_heatmap"
        ]
      },
      {
        "name": "spy_fwd_12m",
        "definition": "Twelve-month forward SPY return",
        "formula": "spy_{t+12} / spy_t - 1",
        "role": "derivative",
        "appears_in_charts": [
          "correlation_heatmap"
        ]
      }
    ]
  },
  "notes": "Scope limited to PERMIT-derived housing signals and SPY returns."
}
