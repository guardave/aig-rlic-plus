{
  "pair_id": "umcsent_xlv",
  "schema_version": "1.0.0",
  "owner": "evan",
  "last_updated_by": "evan",
  "last_updated_at": "2026-10-20T15:51:47.713662+00:00",
  "indicator_axis": {
    "canonical_column": "umcsent",
    "display_name": "University of Michigan Consumer Sentiment",
    "derivatives": [
      {
        "name": "umcsent",
        "definition": "The University of Michigan index of consumer sentiment (monthly survey).",
        "formula": "raw column (ALFRED/FRED UMCSENT; real-time vintages on the headline track)",
        "role": "raw",
        "appears_in_charts": [
          "hero",
          "history_zoom_dotcom",
          "history_zoom_gfc",
          "history_zoom_covid",
          "history_zoom_inflation_2022"
        ],
        "notes": "Tournament signal S1_level."
      },
      {
        "name": "umcsent_yoy",
        "definition": "Year-over-year percent change in consumer sentiment.",
        "formula": "(umcsent / umcsent.shift(12) - 1) * 100",
        "role": "derivative",
        "appears_in_charts": [
          "hero",
          "correlation_scatter",
          "correlations",
          "regime_stats",
          "ccf",
          "signal_dist",
          "local_projections",
          "quantile_coef",
          "rolling_correlation",
          "rolling_granger",
          "structural_break"
        ],
        "notes": "Tournament signal S2_yoy."
      },
      {
        "name": "umcsent_mom",
        "definition": "Month-over-month percent change in consumer sentiment.",
        "formula": "(umcsent / umcsent.shift(1) - 1) * 100",
        "role": "derivative",
        "appears_in_charts": [
          "correlations"
        ],
        "notes": "Tournament signal S3_mom."
      },
      {
        "name": "umcsent_zscore",
        "definition": "Consumer sentiment relative to its trailing 36-month mean, in standard deviations.",
        "formula": "(umcsent - rolling_mean_36(umcsent)) / rolling_std_36(umcsent), min 24 readings",
        "role": "derivative",
        "appears_in_charts": [
          "correlations",
          "equity_curves",
          "drawdown",
          "lead_plateau"
        ],
        "notes": "Tournament signal S4_zscore."
      },
      {
        "name": "umcsent_3m_ma",
        "definition": "Three-month moving average of consumer sentiment.",
        "formula": "umcsent.rolling(3, min_periods=2).mean()",
        "role": "derivative",
        "appears_in_charts": [
          "correlations"
        ],
        "notes": "Tournament signal S5_3m_ma."
      },
      {
        "name": "umcsent_direction",
        "definition": "Direction of the monthly change: +1 rising, -1 falling, 0 unchanged.",
        "formula": "sign(umcsent_mom)",
        "role": "derivative",
        "appears_in_charts": [
          "correlations",
          "signal_dist"
        ],
        "notes": "Tournament signal S6_direction. Long/cash only (P2/P3 excluded on this flag)."
      },
      {
        "name": "umcsent_dev_ma",
        "definition": "Consumer sentiment minus its three-month moving average.",
        "formula": "umcsent - umcsent_3m_ma",
        "role": "derivative",
        "appears_in_charts": [
          "correlations"
        ],
        "notes": "Tournament signal S7_dev_ma."
      }
    ]
  },
  "target_axis": {
    "canonical_column": "xlv",
    "display_name": "Health Care Select Sector (XLV)",
    "derivatives": [
      {
        "name": "xlv",
        "definition": "XLV adjusted month-end close (dividends and splits).",
        "formula": "pinned month-end extract",
        "role": "raw",
        "appears_in_charts": [
          "hero",
          "history_zoom_dotcom",
          "history_zoom_gfc",
          "history_zoom_covid",
          "history_zoom_inflation_2022"
        ],
        "notes": ""
      },
      {
        "name": "xlv_ret",
        "definition": "XLV monthly return.",
        "formula": "xlv.pct_change()",
        "role": "derivative",
        "appears_in_charts": [
          "equity_curves",
          "drawdown",
          "rolling_sharpe",
          "walk_forward",
          "subperiod_sharpe",
          "ccf",
          "regime_stats",
          "rolling_correlation",
          "rolling_granger",
          "structural_break"
        ],
        "notes": ""
      },
      {
        "name": "xlv_fwd_1m",
        "definition": "XLV return over the next month.",
        "formula": "xlv.shift(-1) / xlv - 1",
        "role": "derivative",
        "appears_in_charts": [
          "correlations"
        ],
        "notes": ""
      },
      {
        "name": "xlv_fwd_3m",
        "definition": "XLV return over the next three months.",
        "formula": "xlv.shift(-3) / xlv - 1",
        "role": "derivative",
        "appears_in_charts": [
          "correlations",
          "signal_dist",
          "quantile_coef",
          "local_projections"
        ],
        "notes": ""
      },
      {
        "name": "xlv_fwd_6m",
        "definition": "XLV return over the next six months.",
        "formula": "xlv.shift(-6) / xlv - 1",
        "role": "derivative",
        "appears_in_charts": [
          "correlations",
          "correlation_scatter",
          "local_projections"
        ],
        "notes": ""
      },
      {
        "name": "xlv_fwd_12m",
        "definition": "XLV return over the next twelve months.",
        "formula": "xlv.shift(-12) / xlv - 1",
        "role": "derivative",
        "appears_in_charts": [
          "correlations",
          "local_projections"
        ],
        "notes": ""
      }
    ]
  },
  "notes": "Seven UMCSENT transforms are the tournament signals (pair spec SIGNALS). VIX, DGS10 and UNRATE are regression controls only (local projections, random forest), not signals."
}
